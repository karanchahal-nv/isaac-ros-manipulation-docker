# Dockerfile.manipulation — Custom rosdep-only layer for Isaac ROS Manipulation
#
# Designed as an additional image layer for the Isaac ROS CLI's layered build system.
# Installs all apt/rosdep dependencies for the manipulation stack so that
# `rosdep install` inside the container is a no-op. Compilation (colcon build)
# happens at container runtime with GPU access.
#
# Usage (via isaac-ros CLI):
#   1. Copy this file + known_deps.txt to ${ISAAC_ROS_WS}/docker/
#   2. Set additional_image_keys: [manipulation] in .isaac-ros-cli/config.yaml
#   3. Run: isaac-ros activate --build-local
#
# Usage (manual build):
#   docker build --build-arg BASE_IMAGE=<base_image_tag> -t isaac_ros_manipulation:latest .

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Prevent interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# ─── Known apt dependencies for the manipulation stack ───
# These are the rosdep-resolved packages for:
#   - isaac_ros_manipulation (release-4.4)
#   - ros2_robotiq_gripper (NVIDIA fork)
#   - serial (tylerjw/serial, ros2 branch)
#   - topic_based_ros2_control (karanchahal-nv fork)
#
# We install them directly instead of running rosdep install because
# the source repos are host-mounted at runtime, not available at build time.

COPY known_deps.txt /tmp/known_deps.txt

RUN apt-get update -y && \
    # Read known_deps.txt, skip comments and blank lines, install all at once
    grep -v '^\s*#' /tmp/known_deps.txt | grep -v '^\s*$' | \
    xargs apt-get install -y --no-install-recommends && \
    # Clean up apt cache to reduce layer size
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/known_deps.txt

# ─── Python dependencies ───
RUN pip install --no-cache-dir --break-system-packages pyvers==0.2.2

# ─── Workspace directory structure ───
RUN mkdir -p /workspaces/isaac_ros-dev/src

# ─── Environment defaults ───
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ISAAC_ROS_ACCEPT_EULA=1
ENV MANIPULATOR_INSTALL_ASSETS=1
ENV FOUNDATIONSTEREO_MODEL_RES=low_res

WORKDIR /workspaces/isaac_ros-dev
