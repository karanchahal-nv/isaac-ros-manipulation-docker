# Dockerfile.manipulation-light — Lightweight Isaac ROS Manipulation environment
#
# CPU-only build: ROS 2 Jazzy + rosdep packages for manipulation stack.
# No CUDA, no PyTorch, no TensorRT, no colcon build.
# Those heavy deps are only needed at compile time (colcon) — we skip that.
#
# Designed for resource-constrained systems (16 GB RAM, limited disk).
# VFS storage driver: each layer is a full copy — keep layers minimal.
#
# Total expected size: ~3-5 GB (vs 20+ GB for full isaac_ros image)

FROM nvcr.io/nvidia/base/ubuntu:noble-20251013

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/bash
SHELL ["/bin/bash", "-c"]

# ─── Locale setup ───
RUN apt-get update && apt-get install -y locales \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8

# ─── Basic tools ───
RUN apt-get update && apt-get install -y \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        gnupg \
        lsb-release \
        python3-pip \
        software-properties-common \
        sudo \
        wget \
    && add-apt-repository universe \
    && rm -rf /var/lib/apt/lists/*

# ─── ROS 2 Jazzy repository ───
RUN curl -L -o /tmp/ros2-apt-source.deb \
        "https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.1.0/ros2-apt-source_1.1.0.noble_all.deb" \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && rm /tmp/ros2-apt-source.deb

# ─── Isaac ROS apt repository (for isaac-ros-cli and rosdep definitions) ───
RUN k="/usr/share/keyrings/nvidia-isaac-ros.gpg" \
    && curl -fsSL https://isaac.download.nvidia.com/isaac-ros/repos.key | gpg --dearmor | tee -a $k > /dev/null \
    && f="/etc/apt/sources.list.d/nvidia-isaac-ros.list" \
    && touch $f \
    && s="deb [signed-by=$k] https://isaac.download.nvidia.com/isaac-ros/release-4.4 $(lsb_release -cs) main" \
    && grep -qxF "$s" $f || echo "$s" | tee -a $f

# ─── Install ROS 2 Jazzy base + colcon + rosdep ───
RUN apt-get update && apt-get install -y \
        ros-jazzy-ros-base \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# ─── Source ROS in bashrc ───
RUN echo "source /opt/ros/jazzy/setup.bash" >> /etc/bash.bashrc \
    && echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> /etc/bash.bashrc

# ─── Setup rosdep with Isaac ROS definitions ───
RUN rosdep init \
    && curl -o /etc/ros/rosdep/sources.list.d/nvidia-isaac.yaml \
        https://raw.githubusercontent.com/NVIDIA-ISAAC-ROS/isaac-ros-cli/release-4.4/docker/rosdep/extra_rosdeps.yaml \
    && echo "yaml file:///etc/ros/rosdep/sources.list.d/nvidia-isaac.yaml" | tee /etc/ros/rosdep/sources.list.d/00-nvidia-isaac.list \
    && rosdep update

# ─── Manipulation stack rosdep packages (apt only, no CUDA deps) ───
COPY known_deps.txt /tmp/known_deps.txt
RUN apt-get update \
    && grep -v '^\s*#' /tmp/known_deps.txt | grep -v '^\s*$' | \
       xargs apt-get install -y --no-install-recommends 2>/dev/null || true \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/known_deps.txt

# ─── Additional ROS manipulation packages ───
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-rmw-cyclonedds-cpp \
        ros-jazzy-moveit \
        ros-jazzy-ros2-control \
        ros-jazzy-ros2-controllers \
        ros-jazzy-robot-state-publisher \
        ros-jazzy-joint-state-publisher \
        ros-jazzy-xacro \
        ros-jazzy-tf2-ros \
        ros-jazzy-cv-bridge \
        ros-jazzy-image-transport \
        python3-git \
    2>/dev/null || true \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ─── Python dependencies ───
RUN pip install --no-cache-dir --break-system-packages pyvers==0.2.2 || true

# ─── Workspace structure ───
RUN mkdir -p /workspaces/isaac_ros-dev/src

# ─── Environment defaults ───
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ISAAC_ROS_ACCEPT_EULA=1
ENV MANIPULATOR_INSTALL_ASSETS=1
ENV FOUNDATIONSTEREO_MODEL_RES=low_res

WORKDIR /workspaces/isaac_ros-dev
CMD ["/bin/bash"]
